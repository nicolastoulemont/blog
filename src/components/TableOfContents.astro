---
import type { MarkdownHeading } from 'astro'
import { CATEGORY_COLOR_VARIANTS, type CategoryColor } from '~/lib/categories'

interface Props {
  headings: MarkdownHeading[]
  activeColor?: CategoryColor
}

const { headings, activeColor = 'gray' } = Astro.props
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4)
const tocId = `toc-${Math.random().toString(36).slice(2)}`
const { bg, text, hoverBg, hoverText } = CATEGORY_COLOR_VARIANTS[activeColor]
const activeClasses = `${bg} ${text}`
---

{
  items.length > 0 ? (
    <aside
      data-toc-root={tocId}
      class="lg:fixed lg:right-0 lg:top-20 lg:w-auto lg:max-w-[280px] lg:rounded-lg lg:p-6 lg:pr-3"
    >
      <button
        type="button"
        data-toc-toggle
        class="fixed bottom-10 right-3 z-30 flex rounded-full bg-blue-500 p-3 shadow-lg dark:bg-blue-800 lg:hidden"
      >
        Menu
      </button>

      <div
        data-toc-panel
        class="fixed inset-x-0 bottom-0 z-30 hidden max-h-[70vh] overflow-auto rounded-t-xl bg-white px-6 pb-6 pt-2 shadow-lg dark:bg-slate-900 lg:static lg:block lg:max-h-[80vh] lg:w-auto lg:rounded-none lg:bg-transparent lg:p-0 lg:shadow-none"
      >
        <div class="flex w-full justify-end p-3 lg:hidden">
          <button
            type="button"
            data-toc-close
            class="flex h-[35px] w-[35px] items-center justify-center text-slate-700 dark:text-white"
          >
            Close
          </button>
        </div>
        <nav class="max-h-[70vh] overflow-scroll lg:max-h-[80vh]">
          <h2 class="mb-2 text-lg font-semibold text-gray-700 dark:text-white">
            On this page
          </h2>
          <ol class="space-y-2">
            {
              items.map((heading, index) => (
                <li class:list={[
                  'my-3 flex',
                  heading.depth === 2 && 'ml-4',
                  heading.depth === 3 && 'ml-8',
                  heading.depth === 4 && 'ml-12',
                ]}>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link
                    class={`w-full rounded-md p-2 text-sm font-normal text-gray-700 transition-colors duration-300 ease-in-out dark:text-white ${hoverBg} ${hoverText}`}
                  >
                    {index === 0 ? 'Top' : heading.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </aside>
  ) : null
}

<script is:inline define:vars={{ tocId, activeClasses }}>
  (() => {
    const root = document.querySelector(`[data-toc-root="${tocId}"]`)
    if (!(root instanceof HTMLElement)) return

    const panel = root.querySelector('[data-toc-panel]')
    const toggle = root.querySelector('[data-toc-toggle]')
    const close = root.querySelector('[data-toc-close]')
    const links = Array.from(root.querySelectorAll('[data-toc-link]'))

    const setOpen = (open) => {
      if (!(panel instanceof HTMLElement)) return
      panel.classList.toggle('hidden', !open && window.innerWidth < 1280)
    }

    if (toggle instanceof HTMLButtonElement) {
      toggle.addEventListener('click', () => setOpen(true))
    }

    if (close instanceof HTMLButtonElement) {
      close.addEventListener('click', () => setOpen(false))
    }

    for (const link of links) {
      link.addEventListener('click', () => setOpen(false))
    }

    const observedHeadings = links
      .map((link) => {
        const href = link.getAttribute('href')
        return href ? document.querySelector(href) : null
      })
      .filter(Boolean)

    if (observedHeadings.length === 0) return

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)

        if (visible.length === 0) return
        const activeId = visible[0].target.id

        links.forEach((link) => {
          const isActive = link.getAttribute('href') === `#${activeId}`
          link.classList.toggle('is-active', isActive)
          if (isActive) {
            link.classList.add(...activeClasses.split(' '))
          } else {
            link.classList.remove(...activeClasses.split(' '))
          }
        })
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: [0, 1] }
    )

    observedHeadings.forEach((heading) => observer.observe(heading))
  })()
</script>
