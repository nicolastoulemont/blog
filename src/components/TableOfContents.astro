---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4)
const tocId = `toc-${Math.random().toString(36).slice(2)}`
---

{
  items.length > 0 ? (
    <aside data-toc-root={tocId} class="xl:sticky xl:top-28 xl:h-fit">
      <button
        type="button"
        data-toc-toggle
        class="surface-card fixed bottom-5 right-5 z-30 inline-flex items-center gap-2 px-4 py-3 text-sm font-medium text-slate-700 dark:text-slate-200 xl:hidden"
      >
        On this page
      </button>

      <div
        data-toc-panel
        class="surface-card fixed inset-x-4 bottom-20 z-30 hidden max-h-[60vh] overflow-auto p-5 xl:static xl:block xl:max-h-none xl:w-72"
      >
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">
            On this page
          </h2>
          <button
            type="button"
            data-toc-close
            class="rounded-full px-2 py-1 text-slate-500 xl:hidden dark:text-slate-400"
          >
            Close
          </button>
        </div>
        <nav>
          <ol class="space-y-2">
            {
              items.map((heading) => (
                <li class:list={[
                  'text-sm leading-6',
                  heading.depth === 3 && 'ml-4',
                  heading.depth === 4 && 'ml-8',
                ]}>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link
                    class="block rounded-xl px-3 py-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-slate-900 dark:hover:text-slate-50"
                  >
                    {heading.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </aside>
  ) : null
}

<script is:inline define:vars={{ tocId }}>
  (() => {
    const root = document.querySelector(`[data-toc-root="${tocId}"]`)
    if (!(root instanceof HTMLElement)) return

    const panel = root.querySelector('[data-toc-panel]')
    const toggle = root.querySelector('[data-toc-toggle]')
    const close = root.querySelector('[data-toc-close]')
    const links = Array.from(root.querySelectorAll('[data-toc-link]'))

    const setOpen = (open) => {
      if (!(panel instanceof HTMLElement)) return
      panel.classList.toggle('hidden', !open && window.innerWidth < 1280)
    }

    if (toggle instanceof HTMLButtonElement) {
      toggle.addEventListener('click', () => setOpen(true))
    }

    if (close instanceof HTMLButtonElement) {
      close.addEventListener('click', () => setOpen(false))
    }

    for (const link of links) {
      link.addEventListener('click', () => setOpen(false))
    }

    const observedHeadings = links
      .map((link) => {
        const href = link.getAttribute('href')
        return href ? document.querySelector(href) : null
      })
      .filter(Boolean)

    if (observedHeadings.length === 0) return

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)

        if (visible.length === 0) return
        const activeId = visible[0].target.id

        links.forEach((link) => {
          const isActive = link.getAttribute('href') === `#${activeId}`
          link.classList.toggle('bg-slate-100', isActive)
          link.classList.toggle('text-slate-950', isActive)
          link.classList.toggle('dark:bg-slate-900', isActive)
          link.classList.toggle('dark:text-slate-50', isActive)
        })
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: [0, 1] }
    )

    observedHeadings.forEach((heading) => observer.observe(heading))
  })()
</script>
