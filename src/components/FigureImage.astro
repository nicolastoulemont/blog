---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

// Rendered for every markdown image in a post. The intrinsic width lets the
// stylesheet cap how far a small drawing is upscaled to fill its figure.
interface Props {
  src: ImageMetadata
  alt?: string
}
const { src, alt = '' } = Astro.props
---

<Image src={src} alt={alt} style={`--figure-w: ${src.width}px`} />
