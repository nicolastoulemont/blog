---
import { FiGithub, FiTwitter } from 'react-icons/fi'
import ThemeToggle from './ThemeToggle.astro'
import { SOCIAL_LINKS } from '~/lib/site'
---

<header class="sticky top-0 z-40 flex w-full items-center justify-center bg-white shadow-lg dark:bg-slate-800">
  <nav class="flex w-full max-w-6xl items-center justify-between px-6 py-2 md:px-12">
    <a href="/" class="flex items-center justify-center">
      <img src="/img/site-logo.svg" alt="home page" class="w-11" />
    </a>
    <div class="flex items-center gap-3">
      <a
        href={SOCIAL_LINKS.twitter}
        target="_blank"
        rel="noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-full transition hover:bg-blue-200 dark:hover:bg-slate-600"
        aria-label="Twitter profile"
      >
        <FiTwitter size="1rem" className="stroke-blue-900 dark:stroke-white" />
      </a>
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-full transition hover:bg-purple-200 dark:hover:bg-slate-600"
        aria-label="GitHub profile"
      >
        <FiGithub size="1rem" className="stroke-purple-900 dark:stroke-white" />
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>
