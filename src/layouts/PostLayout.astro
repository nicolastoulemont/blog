---
import { render } from 'astro:content'
import { PostCard } from '~/components/PostCard'
import TableOfContents from '~/components/TableOfContents.astro'
import { CATEGORY_COLOR_REGISTRY } from '~/lib/categories'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getAllPosts, getRelatedPosts, getTranslation, type BlogPost } from '~/lib/blog'

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const allPosts = await getAllPosts()
const relatedPosts = getRelatedPosts(post, allPosts)
const translation = getTranslation(post, allPosts)
const { Content, headings } = await render(post.entry)
const activeColor =
  post.categories.length > 0 ? CATEGORY_COLOR_REGISTRY[post.categories[0]] : 'gray'
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={post.ogImage}
  locale={post.locale}
  ogType="article"
  pathname={post.url}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  alternates={translation ? [{ locale: translation.locale, url: translation.url }] : []}
>
  <main class="relative pb-16">
    {
      translation ? (
        <div class="mb-6 px-6 pt-8 text-sm text-slate-700 md:px-12 dark:text-slate-300">
          {post.locale === 'fr'
            ? 'Version anglaise disponible'
            : 'This post is also available in'}{' '}
          <a
            href={translation.url}
            class="font-medium underline decoration-blue-400 underline-offset-4"
          >
            {post.locale === 'fr' ? 'ici' : translation.localeLabel}
          </a>
          .
        </div>
      ) : null
    }

    <article
      class="post-article prose dark:prose-invert lg:prose-lg m-0 mx-auto w-full px-6 py-10 lg:mx-0 lg:px-12"
    >
      <Content />

      {
        relatedPosts.length > 0 ? (
          <section class="not-prose mt-12">
            <h2 class="mb-3 text-xl font-bold text-slate-800 sm:text-3xl dark:text-white">
              {post.locale === 'fr'
                ? post.categories.length > 1
                  ? 'Articles des mêmes catégories'
                  : 'Articles de la même catégorie'
                : `From the same ${post.categories.length > 1 ? 'categories' : 'category'}`}
            </h2>
            <div>
              {relatedPosts.map((relatedPost) => (
                <PostCard post={relatedPost} showLocale={false} />
              ))}
            </div>
          </section>
        ) : null
      }
    </article>
    <TableOfContents headings={headings} activeColor={activeColor} />
  </main>
</BaseLayout>
