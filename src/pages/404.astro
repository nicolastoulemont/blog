---
import BaseLayout from '~/layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <main class="mx-auto flex min-h-[70vh] max-w-4xl items-center justify-center px-6 py-12">
    <section class="surface-card w-full max-w-2xl p-8 text-center sm:p-12">
      <img src="/img/404.png" alt="404 illustration" class="mx-auto w-36" />
      <p class="mt-6 text-sm uppercase tracking-[0.32em] text-slate-500 dark:text-slate-400">
        404
      </p>
      <h1 class="mt-4 text-4xl font-semibold text-slate-950 dark:text-slate-50">
        Page not found
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        The requested page does not exist anymore or never existed in this version of the site.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-slate-200"
      >
        Back home
      </a>
    </section>
  </main>
</BaseLayout>
