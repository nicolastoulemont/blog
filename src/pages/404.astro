---
import BaseLayout from '~/layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist."
>
  <main class="relative flex min-h-[70vh] items-center justify-center px-5 py-12">
    <section class="w-full max-w-2xl border border-line-strong bg-panel p-8 sm:p-12">
      <p class="text-xs text-muted">404</p>
      <h1 class="mt-4 text-3xl font-bold">Page not found</h1>
      <p class="mt-4 text-sm text-muted">The page you were looking for does not exist.</p>
      <a href="/" class="mt-8 inline-block text-accent underline underline-offset-4">
        Back home →
      </a>
    </section>
  </main>
</BaseLayout>
