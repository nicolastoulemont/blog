---
import { getAllPosts } from '~/lib/blog'

export async function getStaticPaths() {
  const posts = await getAllPosts()

  return posts
    .filter((post) => post.locale === 'fr')
    .map((post) => ({
      params: { year: post.year, slug: post.slug },
      props: { destination: post.url },
    }))
}

return Astro.redirect(Astro.props.destination, 301)
---
