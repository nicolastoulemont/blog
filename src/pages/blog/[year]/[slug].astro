---
import { render } from 'astro:content'
import { PostCard } from '~/components/PostCard'
import TableOfContents from '~/components/TableOfContents.astro'
import { CATEGORY_COLOR_REGISTRY } from '~/lib/categories'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getAllPosts, getRelatedPosts, getTranslation } from '~/lib/blog'

export async function getStaticPaths() {
  const posts = await getAllPosts()

  return posts
    .filter((post) => post.locale === 'en')
    .map((post) => ({
      params: { year: post.year, slug: post.slug },
      props: { post },
    }))
}

const { post } = Astro.props
const allPosts = await getAllPosts()
const relatedPosts = getRelatedPosts(post, allPosts)
const translation = getTranslation(post, allPosts)
const { Content, headings } = await render(post.entry)
const activeColor = post.categories.length > 0 ? CATEGORY_COLOR_REGISTRY[post.categories[0]] : 'gray'
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={post.ogImage}
  locale={post.locale}
  ogType="article"
  pathname={post.url}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  alternates={translation ? [{ locale: translation.locale, url: translation.url }] : []}
>
  <main class="mx-auto max-w-6xl px-6 pb-16 pt-8 md:px-12">
    {translation ? (
      <div class="mb-6 text-sm text-slate-700 dark:text-slate-300">
        This post is also available in{' '}
        <a href={translation.url} class="font-medium underline decoration-blue-400 underline-offset-4">
          {translation.localeLabel}
        </a>
        .
      </div>
    ) : null}

    <div class="relative">
      <article class="prose m-0 mx-auto w-full px-0 py-6 lg:max-w-[calc(100%-250px)]">
        <Content />

        {relatedPosts.length > 0 ? (
          <section class="not-prose mt-12">
            <h2 class="mb-3 text-xl font-bold text-slate-800 dark:text-white sm:text-3xl">
              From the same {post.categories.length > 1 ? 'categories' : 'category'}
            </h2>
            <div>
              {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} showLocale={false} />)}
            </div>
          </section>
        ) : null}
      </article>
      <TableOfContents headings={headings} activeColor={activeColor} />
    </div>
  </main>
</BaseLayout>
