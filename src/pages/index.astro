---
import PostFilter from '~/components/PostFilter.astro'
import { PostCard } from '~/components/PostCard'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getAllPosts } from '~/lib/posts'
const posts = (await getAllPosts()).filter((post) => post.locale === 'en')
const newest = [...posts].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))[0]
const searchPosts = newest ? posts.filter((post) => post.id !== newest.id) : posts
---

<BaseLayout pathname="/">
  <main class="relative">
    <section class="grid border-b border-line min-[56.01rem]:grid-cols-2">
      <div class="border-b border-line bg-bg px-5 py-5 min-[56.01rem]:border-r min-[56.01rem]:border-b-0 min-[56.01rem]:px-6">
        <h1 class="sr-only">Nicolas Toulemont, engineering blog</h1>
        <p class="max-w-xl text-[1.0625rem] leading-[1.7]">
          Full stack engineer in Paris. I love making large codebases scale and teams ship
          faster. I enjoy building products too, and write about what I learn doing both.
        </p>
      </div>
      <div class="flex flex-col px-5 py-6 min-[56.01rem]:pr-6 min-[56.01rem]:pl-0">
        {newest && <PostCard post={newest} variant="featured" />}
      </div>
    </section>
    <PostFilter posts={searchPosts} />
  </main>
</BaseLayout>
